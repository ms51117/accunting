# تنظیمات پایه سامانه
APP_NAME=سامانه حسابداری شخصی
SECRET_KEY=change-this-secret-key-for-production-security
APP_PORT=8000

# اطلاعات ورود مدیر پیش‌فرض در اولین اجرای برنامه
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_CHAT_ID=

# آدرس پایگاه داده SQLite (در حالت داکر در پوشه data نگهداری می‌شود)
DATABASE_URL=sqlite:///./data/accounting.db

# تنظیمات ربات تلگرام (اختیاری جهت دریافت بک‌آپ و یادآور سررسید چک‌ها)
TELEGRAM_BOT_TOKEN=

# تنظیمات پروکسی تلگرام (در صورت نیاز به پروکسی در سرورهای داخلی)
# HTTP_PROXY=http://127.0.0.1:10809
# HTTPS_PROXY=http://127.0.0.1:10809

# تونل اینترنتی عمومی کلودفلر (True جهت فعال بودن، False جهت غیرفعال‌سازی)
CLOUDFLARE_TUNNEL_ENABLED=True
